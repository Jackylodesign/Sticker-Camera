{
  "name": "sticker-camera",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:plugin": "node scripts/build-plugin.mjs",
    "start": "next start",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "exifr": "^7.1.3",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
