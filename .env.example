# Copy this file to .env.local for running on your computer.
# On Vercel, set the same names in Project → Settings → Environment Variables.

# Sign-in (Auth.js). Make a secret with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# From your Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The only Google account allowed to sign in
OWNER_EMAIL=you@gmail.com
# On Vercel only (Production AND Preview): lets preview deployments sign in
# through the production domain, so Google needs just one redirect URL.
# AUTH_REDIRECT_PROXY_URL=https://sticker-camera-brown.vercel.app/api/auth

# Postgres (Neon). Added for you when you connect the Neon database in Vercel.
DATABASE_URL=

# Vercel Blob (private store). Added for you when you connect the Blob store.
BLOB_READ_WRITE_TOKEN=
